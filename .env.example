# Copy this file to `.env` and fill in your real API keys.
# `.env` is gitignored and must never be committed (see .gitignore).
#
# At least one of the two provider keys below is required, matching
# whichever provider(s) you use via src/config.py:DEFAULT_LLM_PROVIDER
# and src/llm/factory.py:get_llm(). Both are required to run the full
# `make eval-llm` model-swap comparison (spec.md section 11.4), since it
# evaluates both backbones (OpenAI gpt-5.4-mini and Google gemini-2.5-flash).

# OpenAI API key (https://platform.openai.com/api-keys) -- used by
# src/llm/openai_client.py for gpt-5.4-mini.
OPENAI_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) -- used by
# src/llm/gemini_client.py for gemini-2.5-flash. Either variable name works;
# GEMINI_API_KEY takes precedence if both are set.
GEMINI_API_KEY=
GOOGLE_API_KEY=
